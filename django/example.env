# Server settings
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Amsterdam

# --- Database ----------------------------------------------------------------
# Nothing set below: the local SQLite file django/db.sqlite3 is used.
#
# Option 1 - a connection string, which is what Neon and Supabase hand you.
# Copy the "psql"/URI string from the Neon dashboard and keep sslmode=require.
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# Option 2 - discrete variables, which is how docker-compose passes its Postgres.
# Set DATABASE_NAME to switch to Postgres; the rest have compose-friendly defaults.
DATABASE_NAME=
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Seconds to keep a connection open. Worth keeping high for a remote database.
CONN_MAX_AGE=600

SQLITE_PATH=
