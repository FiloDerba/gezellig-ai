# Copy to .env and fill in as needed.
# The playground uses this local Ollama model by default.
PLAYGROUND_MODEL=qwen3.6:35b-a3b
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional, only for an Ollama-compatible server that requires authentication.
OLLAMA_API_KEY=

# RAG playground: the Ollama embedding model (ollama pull bge-m3) and the document to index.
RAG_EMBED_MODEL=bge-m3
RAG_DOC=data/rag/setting-the-darkness-ablaze.docx
# Where the search runs: lancedb (default) or numpy (no database, same results).
RAG_STORE=lancedb

# The Dutch tutor and pronunciation coach use Gemini — get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# https://tavily.com — used by the web_search tool (also has a free tier)
TAVILY_API_KEY=

# Optional: https://logfire.pydantic.dev
LOGFIRE_TOKEN=
