# Copy to .env and fill in. pydantic-ai picks these up via provider env vars.
# Default agent model is Gemini (free tier) — get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# https://tavily.com — used by the web_search tool (also has a free tier)
TAVILY_API_KEY=

# Optional: https://logfire.pydantic.dev
LOGFIRE_TOKEN=
